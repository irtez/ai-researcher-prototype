# LLM routing for agents
BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=...

# Python executor container (optional overrides)
CODEARKT_EXECUTOR_IMAGE=phoenix120/codearkt_http@sha256:54b14fca72705bf30ea9051806748ff226ed9f59eeb032f54fb15fc3b7e5332c
CODEARKT_EXECUTOR_URL=

# macOS/Windows (Docker Desktop): disable host-gateway mapping
CODEARKT_DISABLE_HOST_GATEWAY=1

